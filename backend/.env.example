# PostgreSQL — same database the crawler/Telegram bot/notification worker use.
# There is only ever one database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=charusat_tracker
DB_USER=charusat_app
DB_PASSWORD=changeme

# JWT — generate a real secret for production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# There is no default; the app refuses to start without this set.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins. Leave empty if the
# frontend and API are served from the same origin through Nginx.
CORS_ORIGINS=

# Required by telegram_bot.py for the /api/telegram/test endpoint.
# Never commit the real value.
BOT_TOKEN=

# Absolute path to the core Result Tracker repository
RESULT_TRACKER_REPO_ROOT=/path/to/charusat-result-tracker