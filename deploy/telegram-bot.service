[Unit]
Description=CHARUSAT Result Tracker — Telegram Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=charusat
Group=charusat

WorkingDirectory=/opt/charusat-result-tracker
EnvironmentFile=/opt/charusat-result-tracker/.env

ExecStart=/opt/charusat-result-tracker/backend/venv/bin/python3 telegram_bot.py

Restart=on-failure
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target