[Unit]
Description=CHARUSAT Result Tracker — Telegram Bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=azureuser
Group=azureuser

WorkingDirectory=/home/azureuser/charusat-result-tracker
EnvironmentFile=/home/azureuser/charusat-result-tracker/.env

ExecStart=/home/azureuser/charusat-result-tracker/.venv/bin/python telegram_bot.py

Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
