[Unit]
Description=CHARUSAT Result Tracker — Admin Dashboard API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=azureuser
Group=azureuser

WorkingDirectory=/home/azureuser/charusat-result-dashboard/backend
EnvironmentFile=/home/azureuser/charusat-result-dashboard/backend/.env

ExecStart=/home/azureuser/charusat-result-dashboard/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
